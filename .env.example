# 复制为 .env 并填写，然后: set -a; source .env; set +a
# 登录网站的用户名和密码（不填密码则每次启动随机生成并打印在日志里）
APP_USERNAME=admin
APP_PASSWORD=change-me

# Alpaca API Key（https://app.alpaca.markets → Paper Trading → API Keys）
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# true = 模拟盘；false = 实盘（还需要 TRADING_LIVE_ENABLED=true 才会真正下单）
ALPACA_PAPER=true
# iex 免费；sip 需要付费订阅
ALPACA_FEED=iex

# 风控
TRADING_ENABLED=true
TRADING_LIVE_ENABLED=false
TRADING_MAX_ORDER_NOTIONAL=10000
TRADING_MAX_OPEN_POSITIONS=10

# 自动交易机器人（美东时间 cron：秒 分 时 日 月 周）
BOTS_SCHEDULER_ENABLED=true
BOTS_CRON=0 50 15 * * MON-FRI
